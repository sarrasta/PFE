# ============================================================================
# Tunisie Telecom Retention Analytics Platform — environment configuration
#
# Copy this file to `.env` in the same directory as docker-compose.yml and
# fill in real values. NEVER commit the resulting `.env` file (it already
# is git-ignored) — see README "Environment variables" for a full reference
# and "How to add the 4 users and admin later" for the account fields below.
# ============================================================================

# ---- Flask -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<TO_BE_GENERATED>

# ---- Database (DW_TT data warehouse, restored automatically on first
# `docker compose up` from ml pfe/datasql/todhia.backup) ------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<TO_BE_GENERATED>
POSTGRES_DB=DW_TT
# Host-side port for connecting a local SQL client directly, if you want to
# inspect the warehouse yourself. The backend always reaches Postgres over
# the internal Docker network regardless of this value.
POSTGRES_EXPOSED_PORT=5432

# ---- Ports exposed on the host ------------------------------------------
BACKEND_PORT=5000
FRONTEND_PORT=8080

# ---- CORS ----------------------------------------------------------------
# Only needed if the frontend is served from somewhere other than
# FRONTEND_PORT above (e.g. running the Vite dev server locally).
CORS_ORIGINS=http://localhost:8080

# ---- Auth / sessions -------------------------------------------------------
JWT_EXPIRES_MINUTES=480

# ---- ML pipeline ----------------------------------------------------------
# 0 = only refresh on startup and via the admin "Refresh" button/endpoint.
# Set >0 to also re-train on a timer (e.g. 1440 = once a day).
ML_REFRESH_INTERVAL_MINUTES=0
# Persistent scored-model artifact; reused after the first successful training.
ML_ARTIFACT_PATH=/app/artifacts/pipeline-cache.pkl
RETENTION_LTV_HORIZON_MONTHS=12
RETENTION_OFFER_COST_TND=15.0

# ---- Users & roles (Section 7/8/14 of the brief) --------------------------
# 1 Admin + 4 standard users. Every field below is optional and independent:
#   - Leave a whole block empty to leave that account disabled.
#   - Set *_PASSWORD for username+password login (POST /api/auth/login).
#   - Set *_ACCESS_TOKEN instead (or as well) for a personal-link login
#     (POST /api/auth/link-login) if you'd rather distribute links than
#     passwords.
#   - each USER_n_ROLE defaults to its matching direction if omitted; ADMIN is always "admin".
#   - *_NAME is just a display name shown in the UI.
#
# Nothing here is a real identifier — replace every <TO_BE_PROVIDED> before
# deploying. The app runs perfectly well with all of these left blank; only
# the login endpoints stay disabled until you fill them in.

ADMIN_USER=<TO_BE_PROVIDED>
ADMIN_PASSWORD=<TO_BE_PROVIDED>
ADMIN_ACCESS_TOKEN=
ADMIN_NAME=

USER_1=<TO_BE_PROVIDED>
USER_1_PASSWORD=<TO_BE_PROVIDED>
USER_1_ACCESS_TOKEN=
USER_1_NAME=
USER_1_ROLE=direction_marketing

USER_2=<TO_BE_PROVIDED>
USER_2_PASSWORD=<TO_BE_PROVIDED>
USER_2_ACCESS_TOKEN=
USER_2_NAME=
USER_2_ROLE=direction_reseau

USER_3=<TO_BE_PROVIDED>
USER_3_PASSWORD=<TO_BE_PROVIDED>
USER_3_ACCESS_TOKEN=
USER_3_NAME=
USER_3_ROLE=direction_financiere

USER_4=<TO_BE_PROVIDED>
USER_4_PASSWORD=<TO_BE_PROVIDED>
USER_4_ACCESS_TOKEN=
USER_4_NAME=
USER_4_ROLE=direction_regionale

# ---- Frontend build-time config -------------------------------------------
# Left as "/api" by default so the frontend's nginx reverse-proxies API
# calls to the backend container — no CORS, no hardcoded host/port.
VITE_API_BASE_URL=/api
